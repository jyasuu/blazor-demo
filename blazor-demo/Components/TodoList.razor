@page "/todolist"
@rendermode InteractiveServer

@inject TodoService TodoService

<h3>Todo List</h3>

@if (todos == null)
{
    <p><em>Loading...</em></p>
}
else if (todos.Count == 0)
{
    <p><em>No todos yet!</em></p>
}
else
{
    <ul>
        @foreach (var todo in todos)
        {
            <li>
                <input type="checkbox" checked="@todo.IsDone" @onchange="(() => ToggleTodo(todo))" />
                @todo.Title
                <button @onclick="(() => DeleteTodo(todo.Id))">Delete</button>
            </li>
        }
    </ul>
}

<input type="text" @bind="newTodoTitle" placeholder="Add a new todo" />
<button @onclick="AddTodo">Add</button>

@code {
    private List<TodoItem> todos;
    private string newTodoTitle;
    private bool firstRender = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            
            todos = await TodoService.GetTodosAsync();
            StateHasChanged();
        }
    }

    private async Task AddTodo()
    {
        Console.WriteLine("AddTodo method called");
        if (!string.IsNullOrWhiteSpace(newTodoTitle))
        {
            Console.WriteLine($"Adding todo: {newTodoTitle}");
            var newTodo = new TodoItem { Title = newTodoTitle };
            await TodoService.AddTodoAsync(newTodo);
            newTodoTitle = string.Empty;
            StateHasChanged();
            todos = await TodoService.GetTodosAsync();
        }
        else
        {
            Console.WriteLine("newTodoTitle is null or whitespace");
        }
    }

    private async Task ToggleTodo(TodoItem todo)
    {
        Console.WriteLine($"Toggling todo: {todo.Title}");
        todo.IsDone = !todo.IsDone;
        await TodoService.UpdateTodoAsync(todo);
            todos = await TodoService.GetTodosAsync();
    }

    private async Task DeleteTodo(Guid id)
    {
        Console.WriteLine($"Deleting todo with id: {id}");
        await TodoService.DeleteTodoAsync(id);
        StateHasChanged();
            todos = await TodoService.GetTodosAsync();
    }
}
